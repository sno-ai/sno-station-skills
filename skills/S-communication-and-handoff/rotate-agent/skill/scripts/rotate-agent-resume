#!/usr/bin/env bash
# rotate-agent-resume — start a fresh agent on a tmux window and point it at a progress record,
# for the case where the working agent is already gone (quota refused, crash, closed window).
# One command replaces the manual init / spawn / call steps. Each step prints `OK <step>`, or
# `FAIL <step>: <what> -> <what to do>` and stops; the last line of a clean run is
# `RESUMED seat=<address> verify=MATCH|DRIFT`. A label resumes once: the lock is
# ${XDG_STATE_HOME:-$HOME/.local/state}/rotate-agent/<work>.resume, kept whenever a receiver exists.
# Exit 0 resumed (or usage printed for no arguments / --help), 1 failed, 2 bad usage. Needs sno (Reach), jq, tmux and the handoff skill's
# `sno handoff-checkpoint` (or a command named with --checkpoint-cmd).
set -Eeuo pipefail

usage() {
  local status="${1:-2}"
  cat >&"$((status == 0 ? 1 : 2))" <<'USAGE'
usage: sno rotate-agent-resume --to codex|claude --cwd <checkout> --checkpoint <progress-record>
                               --work <label> [--report-to <seat-address>] [--checkpoint-cmd <cmd>]
prints one line per step: OK <step> | FAIL <step>: <what> -> <what to do> | RESUMED seat=<address> verify=MATCH|DRIFT
USAGE
  exit "$status"
}

TO="" CWD="" CHECKPOINT="" WORK="" REPORT_TO="" CKPT_CMD=(sno handoff-checkpoint)
(( $# > 0 )) || usage 0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --to) TO="${2:-}"; shift 2 ;;
    --cwd) CWD="${2:-}"; shift 2 ;;
    --checkpoint) CHECKPOINT="${2:-}"; shift 2 ;;
    --work) WORK="${2:-}"; shift 2 ;;
    --report-to) REPORT_TO="${2:-}"; shift 2 ;;
    --checkpoint-cmd) CKPT_CMD=("${2:-}"); shift 2 ;;
    -h|--help) usage 0 ;;
    *) printf 'rotate-agent-resume: unknown option %s\n' "$1" >&2; usage ;;
  esac
done
[[ "$TO" =~ ^(codex|claude)$ && "$WORK" =~ ^[a-z0-9][a-z0-9-]*$ && -n "$CWD" && -n "$CHECKPOINT" ]] || usage
# The receiver starts in $CWD, so a relative path would mean something else there: use absolute paths throughout.
CWD="$(realpath -m -- "$CWD")"
CHECKPOINT="$(realpath -m -- "$CHECKPOINT")"

HOST="$(hostname -s | tr '[:upper:]' '[:lower:]')"
readonly SEAT="resume.$WORK@$HOST"
readonly ROOT="${SNO_REACH_ROOT:-$HOME/.local/state/sno-reach}"
readonly LOCK_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/rotate-agent"
readonly LOCK="$LOCK_DIR/$WORK.resume"
readonly STARTUP_SECONDS=90

ok() { printf 'OK %s\n' "$1"; }
FAIL_KEEP_LOCK=0 LOCK_OWNED=0
fail() { # step what what-to-do
  printf 'FAIL %s: %s -> %s\n' "$1" "$2" "$3"
  exit 1
}
cleanup() {
  local rc=$?
  trap - EXIT
  if (( rc != 0 && FAIL_KEEP_LOCK == 0 && LOCK_OWNED == 1 )); then rm -f -- "$LOCK"; fi
  exit "$rc"
}
trap cleanup EXIT

# 1. Tools, the checkout, and a progress record the checkout can be compared with.
for tool in sno jq tmux timeout "${CKPT_CMD[0]}"; do
  command -v "$tool" >/dev/null || fail tools "$tool is not on PATH" "install it (sno setup installs sno, with handoff-checkpoint as a sno subcommand)"
done
[[ -d "$CWD" ]] && git -C "$CWD" rev-parse --show-toplevel >/dev/null 2>&1 || fail checkout "$CWD is not a git work tree" "pass the checkout the working agent used"
verify_status=0
verify_out="$("${CKPT_CMD[@]}" --verify "$CHECKPOINT" 2>&1)" || verify_status=$?
(( verify_status <= 1 )) || fail checkpoint "${verify_out%%$'\n'*}" "point --checkpoint at a record made by sno handoff-checkpoint"
verify="MATCH"
(( verify_status == 0 )) || verify="DRIFT"
# The record belongs to one checkout; the receiver must work in that one, not in another working copy.
recorded="$(sed -n '/^<!-- machine-record:start -->$/,/^<!-- machine-record:end -->$/s/^checkout: //p' -- "$CHECKPOINT" | head -n1)"
actual="$(git -C "$CWD" rev-parse --show-toplevel)"
[[ "$(realpath -m -- "$recorded")" == "$(realpath -m -- "$actual")" ]] ||
  fail checkout "the progress record belongs to $recorded but --cwd is $actual" "pass --cwd $recorded, or point --checkpoint at the record of $actual"
ok checkpoint

# 2. Once per label: the lock file is created atomically before anything starts.
mkdir -p -- "$LOCK_DIR"
if ! ( set -o noclobber; printf 'seat=%s state=starting at=%s\n' "$SEAT" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$LOCK" ) 2>/dev/null; then
  FAIL_KEEP_LOCK=1
  existing="$(sed -n 's/.*seat=\([^ ]*\).*/\1/p' "$LOCK" 2>/dev/null | head -n1)"
  fail once "'$WORK' was already resumed as ${existing:-an earlier seat} ($(cat "$LOCK" 2>/dev/null))" "read it with: sno reach watch ${existing:-$SEAT}; use a new --work label for a new resume"
fi
LOCK_OWNED=1
ok once

# 3. The receiver: a seat on a tmux window in the checkout, past its startup turn.
timeout 30 sno reach init --as "$SEAT" --name resume >/dev/null 2>&1 || fail init "sno reach init --as $SEAT refused" "run it by hand and read its message"
spawned="$(timeout 120 sno reach spawn "$TO" --as "$SEAT" --cwd "$CWD" --window 2>&1)" ||
  fail spawn "sno reach spawn $TO --window refused: ${spawned##*$'\n'}" "fix what it names, then rerun"
FAIL_KEEP_LOCK=1
sed -i 's/state=starting/state=started/' "$LOCK"
pane="$(jq -r '.identity.value' "$ROOT/$SEAT/reachable.json" 2>/dev/null || true)"
sno reach watch "$SEAT" --idle 10 --timeout "$STARTUP_SECONDS" >/dev/null 2>&1 ||
  fail start "$TO kept printing for ${STARTUP_SECONDS}s after spawn" "open $TO in $CWD by hand and see what it is doing; the seat $SEAT exists"
if [[ -n "$pane" ]] && tmux capture-pane -p -t "$pane" 2>/dev/null | grep -qi 'trust'; then
  fail trust "$TO stopped at its trust prompt in $CWD" "open $TO once in $CWD by hand, accept the prompt, then read the seat: sno reach watch $SEAT"
fi
# A receiver can be quiet for ten seconds while it still loads its model; text typed then is lost.
if [[ -n "$pane" ]]; then
  for _ in $(seq 30); do tmux capture-pane -p -t "$pane" 2>/dev/null | grep -qi 'loading' || break; sleep 2; done
fi
ok receiver

# 4. Tell it what to do, and wait for a fresh acknowledgement line, not an echo of the prompt.
nonce="$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
prompt="You are taking over a task another agent could not finish (it stopped for quota or crashed).
Checkout: $CWD
Progress record: $CHECKPOINT
1. Read the whole progress record. Its Next list is your task list. Done is finished: do not redo it.
2. The record was just compared with the checkout. The result was:
$verify_out
   If it shows DRIFT, the previous agent worked after its last checkpoint: read those commits and files first (git log, git diff), decide what they finished, and add that to Done before you continue.
3. Print one line, on its own: RESUME_ACK $nonce
4. Continue from Next in this checkout. After every finished task run: ${CKPT_CMD[*]} $CHECKPOINT   and update Done and Next in the record.
5. When every task is done print DONE_$WORK on its own line. If a task needs the owner, print BLOCKED_$WORK <reason> on its own line instead; never print DONE_$WORK while a task waits on the owner."
[[ -z "$REPORT_TO" ]] || prompt+=$'\n'"Report the final result to $REPORT_TO."
# Codex takes the Enter that follows a long pasted prompt as part of the paste, so the prompt can sit unsent
# in its input box. While the call waits, press Enter every 5 seconds; on an empty or busy box it does nothing.
timeout 330 sno reach call "$SEAT" "$prompt" --expect "RESUME_ACK $nonce" --timeout 300 >/dev/null 2>&1 &
call_pid=$!
if [[ "$TO" == codex && -n "$pane" ]]; then
  for _ in $(seq 60); do
    sleep 5
    kill -0 "$call_pid" 2>/dev/null || break
    tmux send-keys -t "$pane" Enter 2>/dev/null || true
  done
fi
wait "$call_pid" ||
  fail acknowledge "$TO did not print RESUME_ACK within 300s" "read what it is doing: sno reach watch $SEAT; do not start a second receiver for '$WORK'"
sed -i "s/state=started/state=resumed verify=$verify/" "$LOCK"
ok acknowledge
printf 'RESUMED seat=%s verify=%s\n' "$SEAT" "$verify"
