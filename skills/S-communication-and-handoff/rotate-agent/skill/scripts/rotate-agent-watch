#!/usr/bin/env bash
# rotate-agent-watch — the heartbeat hook for quota-triggered failover between agent
# harness vendors (codex <-> claude, either direction). One run is one tick: it reads the
# working vendor's remaining subscription, applies the threshold, checks the receiver, and
# records the trigger in a state file so it fires once. Every decision here is code; the
# watching agent only relays the line this prints. Exit 0 on every verdict; 2 on bad usage.
set -Eeuo pipefail

usage() {
  cat >&2 <<'USAGE'
usage: rotate-agent-watch --from codex|claude --to codex|claude --state <file> --cwd <checkout>
                      [--threshold-pct <N>] [--quota-cmd <cmd>]
prints one line: DONE | HOLD | LATE | ROTATE | COMPLETE ...
USAGE
  exit 2
}

FROM="" TO="" STATE="" CWD="" THRESHOLD=2 QUOTA_CMD=(sno subscription-quota-check)
while [[ $# -gt 0 ]]; do
  case "$1" in
    --from) FROM="${2:-}"; shift 2 ;;
    --to) TO="${2:-}"; shift 2 ;;
    --state) STATE="${2:-}"; shift 2 ;;
    --cwd) [[ -n "${2:-}" ]] || usage; CWD="$2"; shift 2 ;;
    --threshold-pct) THRESHOLD="${2:-}"; shift 2 ;;
    --quota-cmd) QUOTA_CMD=("${2:-}"); shift 2 ;;
    -h|--help) usage ;;
    *) printf 'rotate-agent-watch: unknown option %s\n' "$1" >&2; usage ;;
  esac
done
[[ "$FROM" =~ ^(codex|claude)$ && "$TO" =~ ^(codex|claude)$ && "$FROM" != "$TO" ]] || usage
[[ -n "$STATE" && -n "$CWD" && "$THRESHOLD" =~ ^[0-9]+$ ]] || usage
CWD="$(cd -- "$CWD" && pwd -P)" || exit 2
command -v jq >/dev/null || { printf 'rotate-agent-watch: jq is required and missing\n' >&2; exit 2; }
command -v "${QUOTA_CMD[0]}" >/dev/null || { printf 'rotate-agent-watch: quota command not found: %s\n' "${QUOTA_CMD[0]}" >&2; exit 2; }

send_event() {
  local event="$1" status run; shift
  if ! command -v sno >/dev/null 2>&1; then
    printf 'sno: not found; %s event not recorded\n' "$event" >&2
    return 0
  fi
  run=(sno observe append "$event" "$@")
  # macOS ships no `timeout`; there the send is unbounded (install coreutils to bound it).
  ! command -v timeout >/dev/null 2>&1 || run=(timeout 60 "${run[@]}")
  if "${run[@]}" >/dev/null 2>&1; then
    :
  else
    status=$?
    printf 'sno observe append %s failed (exit %s); event not recorded\n' "$event" "$status" >&2
  fi
  return 0
}

send_quota() {
  local harness="$1" used="$2" reset="$3" remaining last=0 throttle now
  [[ "$used" =~ ^[0-9]+([.][0-9]+)?$ ]] || return 0
  [[ "$harness" != claude ]] || harness=claude-code
  remaining="$(jq -n --arg used "$used" '[0, 100 - ($used | tonumber)] | max | select(. < 10)')"
  [[ -n "$remaining" ]] || return 0
  if [[ ! "$reset" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    printf 'rotate-agent-watch: %s reset time missing or nonnumeric; handoff.quota event not recorded\n' "$harness" >&2
    return 0
  fi
  throttle="$STATE.quota-$harness"
  [[ ! -f "$throttle" ]] || { read -r last < "$throttle" || last=0; }
  [[ "$last" =~ ^[0-9]+$ ]] || last=0
  now="$(date -u +%s)"
  (( now - last >= 3600 )) || return 0
  send_event handoff.quota "--agent=$harness" "--project=$CWD" \
    "--harness=$harness" "--remaining_pct=$remaining" "--reset_in_s=$reset"
  if ! { mkdir -p -- "$(dirname -- "$STATE")" && printf '%s\n' "$now" > "$throttle.tmp" && mv -f -- "$throttle.tmp" "$throttle"; } 2>/dev/null; then
    printf 'rotate-agent-watch: cannot record quota send time in %s\n' "$throttle" >&2
  fi
  return 0
}

# The quota command exits non-zero for wait/unknown; the JSON verdict is the answer, not the status.
read_quota() {
  local vendor="$1" out
  out="$("${QUOTA_CMD[@]}" --vendor "$vendor" --json --quiet 2>/dev/null || true)"
  jq -r '(.vendors[0].verdict // "unknown"), (.vendors[0].tightest_window.used_pct // "null"),
         (.vendors[0].tightest_window.seconds_to_reset // "null")' <<<"$out" 2>/dev/null \
    || printf 'unknown\nnull\nnull\n'
}

ROTATED=""
if [[ -f "$STATE" ]] && grep -q '^rotated ' -- "$STATE"; then
  ROTATED="$(grep -m1 '^rotated ' -- "$STATE")"
fi
if [[ -n "$ROTATED" ]] && grep -q '^completed ' -- "$STATE"; then
  printf 'DONE %s\n' "$ROTATED"
  exit 0
fi

{ read -r FROM_VERDICT; read -r USED; read -r RESET; } < <(read_quota "$FROM")
if ! COMMITS="$(git -C "$CWD" rev-list --count HEAD 2>&1)"; then
  printf 'rotate-agent-watch: git rev-list failed in %s: %s\n' "$CWD" "${COMMITS//$'\n'/; }" >&2
  COMMITS=""
fi
send_quota "$FROM" "$USED" "$RESET"

if [[ -n "$ROTATED" ]]; then
  read -r _ ROTATED_STAMP _ _ SENDER_REMAINING COMMITS_BEFORE <<<"$ROTATED"
  COMMITS_BEFORE="${COMMITS_BEFORE#commits=}"
  if [[ "$COMMITS" =~ ^[0-9]+$ && "$COMMITS_BEFORE" =~ ^[0-9]+$ ]] && (( COMMITS > COMMITS_BEFORE )); then
    SECONDS_TOTAL=$(( $(date -u +%s) - $(jq -n --arg t "$ROTATED_STAMP" '$t | fromdateiso8601') ))
    TO_HARNESS="$TO"; [[ "$TO_HARNESS" != claude ]] || TO_HARNESS=claude-code
    SENDER_REMAINING="${SENDER_REMAINING#remaining=}"
    send_event handoff.complete "--agent=$TO_HARNESS" "--project=$CWD" \
      "--total_seconds=$SECONDS_TOTAL" "--sender_remaining_pct=${SENDER_REMAINING%\%}" \
      "--commits_before=$COMMITS_BEFORE" "--commits_after=$COMMITS"
    printf 'completed %s commits=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$COMMITS" >> "$STATE"
    printf 'COMPLETE from=%s to=%s seconds=%s commits_before=%s commits_after=%s\n' "$FROM" "$TO" "$SECONDS_TOTAL" "$COMMITS_BEFORE" "$COMMITS"
  else
    printf 'DONE %s\n' "$ROTATED"
  fi
  exit 0
fi
case "$FROM_VERDICT" in
  wait|owner_action) printf 'LATE blocked verdict=%s reset_in=%ss\n' "$FROM_VERDICT" "$RESET"; exit 0 ;;
  go|short_only) ;;
  *) printf 'HOLD unreadable verdict=%s\n' "$FROM_VERDICT"; exit 0 ;;
esac
[[ "$USED" =~ ^[0-9]+$ ]] || { printf 'HOLD unreadable verdict=%s used_pct=%s\n' "$FROM_VERDICT" "$USED"; exit 0; }
REMAINING=$((100 - USED))
(( REMAINING >= 0 )) || REMAINING=0
if (( REMAINING > THRESHOLD )); then
  printf 'HOLD from=%s remaining=%s%% threshold=%s%%\n' "$FROM" "$REMAINING" "$THRESHOLD"
  exit 0
fi

{ read -r TO_VERDICT; read -r TO_USED; read -r TO_RESET; } < <(read_quota "$TO")
send_quota "$TO" "$TO_USED" "$TO_RESET"
case "$TO_VERDICT" in
  go|short_only) ;;
  *) printf 'HOLD receiver-%s from=%s remaining=%s%%\n' "$TO_VERDICT" "$FROM" "$REMAINING"; exit 0 ;;
esac

mkdir -p -- "$(dirname -- "$STATE")"
STAMP="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
printf 'rotated %s from=%s to=%s remaining=%s%% commits=%s\n' "$STAMP" "$FROM" "$TO" "$REMAINING" "$COMMITS" > "$STATE.tmp"
mv -f -- "$STATE.tmp" "$STATE"
printf 'ROTATE from=%s to=%s remaining=%s%% reset_in=%ss\n' "$FROM" "$TO" "$REMAINING" "$RESET"
FROM_HARNESS="$FROM"; [[ "$FROM_HARNESS" != claude ]] || FROM_HARNESS=claude-code
TO_HARNESS="$TO"; [[ "$TO_HARNESS" != claude ]] || TO_HARNESS=claude-code
send_event handoff.trigger "--agent=$FROM_HARNESS" "--project=$CWD" \
  "--from_harness=$FROM_HARNESS" "--to_harness=$TO_HARNESS" \
  "--remaining_pct=$REMAINING" "--threshold_pct=$THRESHOLD"
