{
  "type": "object",
  "properties": {
    "lesson": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/lesson" }] }
  },
  "required": ["lesson"],
  "additionalProperties": false,
  "$defs": {
    "lesson": {
      "type": "object",
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "class": { "enum": ["SKILL_DEFECT", "EXECUTION_LAPSE"] },
        "situation": {
          "type": "object",
          "properties": {
            "task_type": { "type": "string", "minLength": 1 },
            "trigger": { "type": "string", "minLength": 1 },
            "tools": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["task_type", "trigger", "tools"],
          "additionalProperties": false
        },
        "advice": { "type": "string", "minLength": 1 },
        "expected_result": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "success_criteria": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "memory_fact_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "because": { "type": "string", "minLength": 1 },
        "polarity": { "enum": ["from_failure", "from_success"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "line_start": { "type": "integer", "minimum": 1 },
              "line_end": { "type": "integer", "minimum": 1 },
              "quote": { "type": "string", "minLength": 1 }
            },
            "required": ["line_start", "line_end", "quote"],
            "additionalProperties": false
          }
        },
        "skill_target": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "reminder_line": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "verdict_line": { "type": "integer", "minimum": 1, "description": "the line of the external verdict (from the External verdicts list in the prompt) this lesson rests on: a passed test for from_success, a failed test, check or build near the evidence for from_failure" }
      },
      "required": ["summary", "class", "situation", "advice", "expected_result", "success_criteria", "memory_fact_ids", "because", "polarity", "evidence", "skill_target", "reminder_line", "verdict_line"],
      "additionalProperties": false
    }
  }
}
