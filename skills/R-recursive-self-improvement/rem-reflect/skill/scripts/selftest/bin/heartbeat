#!/usr/bin/env -S node --experimental-strip-types
// Fixture `heartbeat` for the rem-reflect selftest. The loop never arms heartbeat during a run; only
// `status` reads `heartbeat --list`. This stand-in records its invocation to $EXEC_LOG and, for
// --list, prints the armed rem-reflect line so `status` sees the daily job as armed. Exits 0.
import { appendFileSync } from 'node:fs';

const argv = process.argv.slice(2);
if (process.env.EXEC_LOG) appendFileSync(process.env.EXEC_LOG, 'heartbeat\n');
if (argv.includes('--list')) process.stdout.write('rem-reflect 1440m -- rem-reflect run\n');
process.exit(0);
